---
// Páginas de contenido (guías para Google): mismo estilo de la app, texto legible y llamados a abrirla.
interface Props {
  title: string;        // <title> completo
  description: string;  // meta description (~150 caracteres)
  path: string;         // '/cuenta-de-cobro'
  image?: string;       // imagen para compartir (por defecto og-image.jpg)
  jsonLd?: object[];
}
const SITE = 'https://cotizador.andersonrueda.com';
const { title, description, path, image = '/og-image.jpg', jsonLd = [] } = Astro.props;
const url = `${SITE}${path}`;
const img = `${SITE}${image}`;
const nav = [
  { href: '/cotizacion', label: 'Cotizaciones' },
  { href: '/cuenta-de-cobro', label: 'Cuenta de cobro' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={url} />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#0f1115" />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Cotizador" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:url" content={url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={img} />
    <meta property="og:image:secure_url" content={img} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={img} />
    {jsonLd.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
    <style is:global>
      :root { --bg: #0f1115; --panel: #15181e; --card: #1a1e26; --border: #2b313c; --text: #e8eaee; --muted: #a3aab8; --accent: #f2d22b; --accent-ink: #1a1a10; --link: #f2d22b; }
      @media (prefers-color-scheme: light) {
        :root { --bg: #f6f7f9; --panel: #ffffff; --card: #ffffff; --border: #e1e4ea; --text: #1c2027; --muted: #555d6b; --link: #7a6a00; }
      }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--bg); color: var(--text); font: 17px/1.7 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; }
      a { color: var(--link); }
      .top { position: sticky; top: 0; z-index: 10; background: color-mix(in srgb, var(--bg) 88%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--border); }
      .top-in { max-width: 980px; margin: 0 auto; padding: 10px 16px; display: flex; align-items: center; gap: 14px; }
      .brand { display: flex; align-items: center; gap: 10px; color: var(--text); text-decoration: none; font-weight: 800; font-size: 18px; margin-right: auto; }
      .top nav { display: flex; gap: 16px; font-size: 15px; }
      .top nav a { color: var(--muted); text-decoration: none; }
      .top nav a[aria-current="page"], .top nav a:hover { color: var(--text); }
      .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 12px 20px; border-radius: 12px; font-weight: 700; text-decoration: none; font-size: 16px; line-height: 1.2; transition: transform .12s, filter .12s; }
      .btn:active { transform: scale(.97); }
      .btn.primary { background: var(--accent); color: var(--accent-ink); }
      .btn.primary:hover { filter: brightness(1.06); }
      .btn.ghost { border: 1px solid var(--border); color: var(--text); }
      .top .btn { padding: 8px 14px; font-size: 14px; }
      main { max-width: 760px; margin: 0 auto; padding: 32px 16px 64px; }
      .hero h1 { font-size: clamp(30px, 6vw, 44px); line-height: 1.15; margin: 8px 0 14px; letter-spacing: -.5px; }
      .eyebrow { color: var(--accent); font-weight: 700; font-size: 13px; letter-spacing: .08em; text-transform: uppercase; }
      .lead { font-size: 19px; color: var(--muted); margin: 0 0 22px; }
      .ctas { display: flex; gap: 10px; flex-wrap: wrap; }
      .badges { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 0; padding: 0; list-style: none; font-size: 14px; color: var(--muted); }
      .badges li { border: 1px solid var(--border); border-radius: 999px; padding: 4px 12px; }
      figure { margin: 36px 0; }
      figure img { width: 100%; height: auto; display: block; border-radius: 12px; border: 1px solid var(--border); box-shadow: 0 20px 50px rgba(0,0,0,.35); background: #fff; }
      figcaption { color: var(--muted); font-size: 14px; margin-top: 10px; text-align: center; }
      h2 { font-size: 26px; line-height: 1.25; margin: 44px 0 12px; }
      h3 { font-size: 19px; margin: 26px 0 8px; }
      p, li { color: color-mix(in srgb, var(--text) 86%, var(--muted)); }
      ul, ol { padding-left: 22px; }
      li + li { margin-top: 6px; }
      .card { background: var(--card); border: 1px solid var(--border); border-radius: 14px; padding: 6px 20px; margin: 18px 0; }
      .pasos { counter-reset: paso; list-style: none; padding: 0; }
      .pasos li { counter-increment: paso; position: relative; padding: 14px 16px 14px 60px; background: var(--card); border: 1px solid var(--border); border-radius: 14px; margin-top: 10px; }
      .pasos li::before { content: counter(paso); position: absolute; left: 16px; top: 14px; width: 30px; height: 30px; border-radius: 50%; background: var(--accent); color: var(--accent-ink); font-weight: 800; display: grid; place-items: center; font-size: 15px; }
      table { width: 100%; border-collapse: collapse; margin: 16px 0; font-size: 15px; }
      th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--border); vertical-align: top; }
      th { color: var(--muted); font-weight: 600; }
      .tabla { overflow-x: auto; }
      details { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 0 16px; margin-top: 8px; }
      summary { cursor: pointer; padding: 14px 0; font-weight: 600; list-style: none; display: flex; justify-content: space-between; gap: 12px; }
      summary::after { content: '+'; color: var(--muted); }
      details[open] summary::after { content: '−'; }
      details p { margin: 0 0 14px; }
      .nota { font-size: 14px; color: var(--muted); border-left: 3px solid var(--border); padding-left: 12px; }
      .cierre { text-align: center; margin: 56px 0 0; padding: 32px 20px; border-radius: 18px; background: var(--card); border: 1px solid var(--border); }
      .cierre h2 { margin-top: 0; }
      footer { border-top: 1px solid var(--border); color: var(--muted); font-size: 14px; }
      footer div { max-width: 980px; margin: 0 auto; padding: 20px 16px; display: flex; gap: 18px; flex-wrap: wrap; }
      footer a { color: var(--muted); }
      @media (max-width: 560px) { .top nav { display: none; } body { font-size: 16px; } }
    </style>
  </head>
  <body>
    <header class="top">
      <div class="top-in">
        <a class="brand" href="/"><img src="/logo.svg" alt="" width="30" height="30" />Cotizador</a>
        <nav aria-label="Guías">{nav.map((n) => <a href={n.href} aria-current={n.href === path ? 'page' : undefined}>{n.label}</a>)}</nav>
        <a class="btn primary" href="/">Abrir la app</a>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div>
        <span>Cotizador · gratis, ilimitado y sin anuncios</span>
        <a href="/cotizacion">Cotizaciones</a>
        <a href="/cuenta-de-cobro">Cuenta de cobro</a>
        <a href="/privacidad">Privacidad</a>
        <a href="https://github.com/AndersonDavi/Cotizador" rel="noopener">Código abierto</a>
      </div>
    </footer>
  </body>
</html>
