---
import '../styles/global.css';
import 'driver.js/dist/driver.css';
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/500.css';
import '@fontsource/roboto/700.css';

const SITE = 'https://cotizador.andersonrueda.com';
const TITLE = 'Cotizador — Propuestas económicas para freelancers';
const DESC  = 'Crea cotizaciones con tu logo, firma y colores en 8 diseños. Exporta PDF con texto seleccionable, PNG y cuentas de cobro. Sin registro ni instalación.';

const ic = (d: string) => `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const I = {
  doc: ic('<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/>'),
  list: ic('<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="4" cy="6" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="18" r="1"/>'),
  palette: ic('<circle cx="13.5" cy="6.5" r="1.5"/><circle cx="17.5" cy="10.5" r="1.5"/><circle cx="8.5" cy="7.5" r="1.5"/><circle cx="6.5" cy="12.5" r="1.5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.9 0 1.6-.7 1.6-1.7 0-.4-.2-.8-.4-1.1-.3-.3-.4-.7-.4-1.1a1.6 1.6 0 0 1 1.7-1.7h2c3 0 5.5-2.5 5.5-5.5C22 6 17.5 2 12 2z"/>'),
  brand: ic('<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/>'),
  cash: ic('<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/>'),
  folder: ic('<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>'),
  upload: ic('<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>'),
  pen: ic('<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>'),
  save: ic('<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>'),
  plus: ic('<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>'),
  download: ic('<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>'),
  more: ic('<circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>'),
  help: ic('<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>'),
  eye: ic('<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>'),
  edit: ic('<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4z"/>'),
  cal: ic('<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>'),
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{TITLE}</title>
    <meta name="description" content={DESC} />
    <meta name="keywords" content="cotizador freelance, propuesta económica, cotización PDF, cuenta de cobro, generador de cotizaciones, presupuesto online" />
    <meta name="author" content="Anderson Rueda" />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="ahZS4qCnXiX1NPEs2xwk0r2orlPFeorWpFTa6KkBEok" />
    <link rel="canonical" href={SITE} />

    <meta property="og:type"         content="website" />
    <meta property="og:url"          content={SITE} />
    <meta property="og:site_name"    content="Cotizador" />
    <meta property="og:title"        content={TITLE} />
    <meta property="og:description"  content={DESC} />
    <meta property="og:locale"       content="es_CO" />
    <meta property="og:image"        content={`${SITE}/og-image.webp`} />
    <meta property="og:image:type"   content="image/webp" />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"    content="Editor de cotizaciones Cotizador — panel de opciones y vista previa de propuesta" />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={TITLE} />
    <meta name="twitter:description" content={DESC} />
    <meta name="twitter:image"       content={`${SITE}/og-image.webp`} />
    <meta name="twitter:image:alt"   content="Editor de cotizaciones Cotizador" />

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#14161b" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Cotizador" />

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo-512.webp" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Cotizador",
      "url": SITE,
      "description": DESC,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "browserRequirements": "Requires JavaScript. Compatible con Chrome, Firefox, Safari y Edge.",
      "inLanguage": "es-CO",
      "isAccessibleForFree": true,
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "COP" },
      "image": `${SITE}/og-image.webp`,
      "screenshot": `${SITE}/og-image.webp`,
      "author": {
        "@type": "Person",
        "name": "Anderson Rueda",
        "url": "https://andersonrueda.com",
        "sameAs": ["https://github.com/AndersonDavi", "https://www.linkedin.com/in/anderson-david-rueda-consuegra/"]
      }
    })} />
  </head>
  <body>
    <div class="app" data-view="edit">
      <!-- ── Editor ─────────────────────────────────────────────────────── -->
      <aside class="editor">
        <header class="topbar">
          <div class="brandmark">
            <img src="/logo.webp" alt="" width="32" height="32" />
            <div>
              <h1>Cotizador</h1>
              <span id="docLabel" class="doc-label">Cotización 00001</span>
            </div>
          </div>
          <button id="tourBtn" class="ghost-btn" title="Ver guía interactiva"><Fragment set:html={I.help} /> Guía</button>
        </header>

        <nav class="tabs" role="tablist" aria-label="Secciones">
          <button role="tab" class="tab active" data-tab="cotizacion" id="tab-cotizacion"><Fragment set:html={I.doc} /><span>Cotización</span></button>
          <button role="tab" class="tab" data-tab="items" id="tab-items"><Fragment set:html={I.list} /><span>Ítems</span><b id="itemsCount" class="count">0</b></button>
          <button role="tab" class="tab" data-tab="diseno" id="tab-diseno"><Fragment set:html={I.palette} /><span>Diseño</span></button>
          <button role="tab" class="tab" data-tab="marca" id="tab-marca"><Fragment set:html={I.brand} /><span>Mi marca</span></button>
          <button role="tab" class="tab" data-tab="cobro" id="tab-cobro"><Fragment set:html={I.cash} /><span>Cobro</span></button>
          <button role="tab" class="tab" data-tab="guardadas" id="tab-guardadas"><Fragment set:html={I.folder} /><span>Guardadas</span></button>
        </nav>

        <div class="panes">
          <!-- Cotización -->
          <section class="pane active" data-pane="cotizacion">
            <div class="card">
              <div class="grid2">
                <label class="field">N.º de cotización<input id="numero" type="text" inputmode="numeric" /></label>
                <label class="field">Fecha
                  <span class="with-btn">
                    <input id="fecha" type="text" placeholder="dd-mm-aaaa" />
                    <button id="fechaPickerBtn" type="button" class="icon-only" title="Elegir en calendario"><Fragment set:html={I.cal} /></button>
                    <input id="fechaHidden" type="date" class="sr-only" tabindex="-1" aria-hidden="true" />
                  </span>
                </label>
              </div>
              <div class="field">Estado
                <div id="estadoGroup" class="seg" role="radiogroup" aria-label="Estado"></div>
              </div>
              <label class="field">Título del documento<input id="titulo" type="text" placeholder="Propuesta económica" /></label>
            </div>

            <div class="card">
              <h3 class="card-title">Cliente</h3>
              <div class="grid2">
                <label class="field">Nombre o empresa<input id="clienteNombre" type="text" placeholder="Empresa S.A.S." /></label>
                <label class="field">NIT / documento<input id="clienteNit" type="text" placeholder="900.000.000" /></label>
              </div>
              <label class="field">Alcance<textarea id="alcance" rows="2" placeholder="Desarrollo de la tienda en línea…"></textarea></label>
            </div>

            <div class="card">
              <h3 class="card-title">Total</h3>
              <div class="total-row">
                <div class="total-big" id="totalBig">$0</div>
                <label class="switch"><input id="costoAuto" type="checkbox" /><span></span> Sumar ítems</label>
              </div>
              <label class="field" id="costoManualWrap">Valor manual (COP)<input id="costoTotal" type="number" min="0" step="1000" /></label>
            </div>

            <div class="card">
              <h3 class="card-title">Condiciones</h3>
              <label class="field">Tiempo de entrega<textarea id="tiempoEntrega" rows="3"></textarea></label>
              <label class="field">Términos y condiciones <small>una línea por término</small><textarea id="terminos" rows="3"></textarea></label>
            </div>
          </section>

          <!-- Ítems -->
          <section class="pane" data-pane="items">
            <div class="items-toolbar">
              <span class="toolbar-label">Ordenar</span>
              <button id="sort-precio" class="chip">Precio</button>
              <button id="sort-titulo" class="chip">Título</button>
              <button id="sort-tipo" class="chip">Tipo</button>
              <button id="toggleAllItems" class="chip chip-outline">Colapsar todo</button>
            </div>
            <div id="items" class="items"></div>
            <button id="addItem" class="add-btn"><Fragment set:html={I.plus} /> Agregar ítem</button>
          </section>

          <!-- Diseño -->
          <section class="pane" data-pane="diseno">
            <div class="card">
              <h3 class="card-title">Plantilla</h3>
              <div id="designGallery" class="gallery"></div>
            </div>
            <div class="card">
              <h3 class="card-title">Colores <small>toda la plantilla sale de estos dos</small></h3>
              <div class="grid2">
                <label class="color-field">
                  <input id="colorPrimary" type="color" />
                  <span><b>Principal</b><input id="colorPrimaryHex" type="text" maxlength="7" spellcheck="false" /></span>
                </label>
                <label class="color-field">
                  <input id="colorSecondary" type="color" />
                  <span><b>Secundario</b><input id="colorSecondaryHex" type="text" maxlength="7" spellcheck="false" /></span>
                </label>
              </div>
              <div class="field">Paletas rápidas<div id="paletteRow" class="palettes"></div></div>
              <div class="link-row">
                <button id="swapColors" class="link-btn" type="button">⇄ Intercambiar colores</button>
                <button id="suggestColors" class="link-btn" type="button">Usar colores sugeridos del diseño</button>
              </div>
            </div>
          </section>

          <!-- Mi marca -->
          <section class="pane" data-pane="marca">
            <p class="hint">Estos datos se guardan en tu navegador y se usan en todas tus cotizaciones.</p>
            <div class="card">
              <h3 class="card-title">Logo y nombre</h3>
              <div class="brand-row">
                <div id="logoArea" class="drop" tabindex="0" role="button" title="Sube o arrastra tu logo">
                  <img id="logoPreview" alt="Logo" />
                  <span class="drop-empty"><Fragment set:html={I.upload} />Logo</span>
                </div>
                <div class="brand-fields">
                  <label class="field">Nombre de tu marca<input id="empresa" type="text" placeholder="Mi Estudio" /></label>
                  <button id="logoClear" class="link-btn danger" type="button">Quitar logo</button>
                </div>
              </div>
              <input id="logoFile" type="file" accept="image/*" hidden />
            </div>

            <div class="card">
              <h3 class="card-title">Quién firma</h3>
              <div class="grid2">
                <label class="field">Nombre<input id="repNombre" type="text" /></label>
                <label class="field">Cédula / NIT<input id="repCedula" type="text" /></label>
              </div>
              <div class="field">Firma
                <div id="firmaArea" class="drop drop-wide" tabindex="0" role="button" title="Sube o arrastra una imagen de tu firma">
                  <img id="firmaPreview" alt="Firma" />
                  <span class="drop-empty"><Fragment set:html={I.pen} />Sube una foto o PNG de tu firma (el fondo blanco se recorta solo)</span>
                </div>
                <button id="firmaClear" class="link-btn danger" type="button">Quitar firma</button>
                <input id="firmaFile" type="file" accept="image/*" hidden />
              </div>
            </div>

            <div class="card">
              <h3 class="card-title">Contacto</h3>
              <div class="grid2">
                <label class="field">Celular<input id="cCel" type="tel" /></label>
                <label class="field">Email<input id="cEmail" type="email" /></label>
              </div>
              <label class="field">Sitio web<input id="cWeb" type="text" placeholder="www.mimarca.com" /></label>
              <div class="grid2">
                <label class="field">Ciudad<input id="cCiudad" type="text" /></label>
                <label class="field">País<input id="cPais" type="text" /></label>
              </div>
            </div>

            <div class="card">
              <h3 class="card-title">Datos para cobrar</h3>
              <label class="field">Cuenta bancaria<input id="banco" type="text" placeholder="Cuenta de Ahorros BANCO No. 000-000000-00" /></label>
              <label class="field">Nombre completo (cuenta de cobro)<input id="nombreLegal" type="text" /></label>
              <label class="field">Dirección<input id="direccion" type="text" /></label>
            </div>
          </section>

          <!-- Cobro -->
          <section class="pane" data-pane="cobro">
            <p class="hint">Genera la cuenta de cobro de esta cotización con el total, tus datos y los del cliente.</p>
            <div class="card">
              <div class="grid2">
                <label class="field">Trabajo desde<input id="cobroDesde" type="date" /></label>
                <label class="field">Hasta<input id="cobroHasta" type="date" /></label>
              </div>
              <label class="field">Fecha de la cuenta<input id="cobroFecha" type="date" /></label>
              <label class="field">Por concepto de <small>el período se agrega solo</small><textarea id="cobroConcepto" rows="3" placeholder="Por actividades de desarrollo correspondientes a…"></textarea></label>
              <div id="cobroFaltan" class="warn" hidden></div>
              <div class="cobro-preview" id="cobroResumen"></div>
              <button id="cuentaBtn" class="primary wide" type="button"><Fragment set:html={I.cash} /> Generar cuenta de cobro (PDF)</button>
              <label class="check"><input id="cobroMarcar" type="checkbox" checked /> Marcar la cotización como <b>cobrada</b></label>
            </div>
          </section>

          <!-- Guardadas -->
          <section class="pane" data-pane="guardadas">
            <div class="saved-tools">
              <input id="savedSearch" type="search" placeholder="Buscar por número, cliente o alcance" />
              <div id="savedFilters" class="chips"></div>
            </div>
            <div id="savedList" class="saved-list"></div>
          </section>
        </div>

        <footer class="actions">
          <button id="saveBtn" class="act" title="Guardar en este navegador"><Fragment set:html={I.save} /><span>Guardar</span></button>
          <button id="newBtn" class="act" title="Nueva cotización"><Fragment set:html={I.plus} /><span>Nueva</span></button>
          <button id="pdfBtn" class="act primary" title="Descargar PDF"><Fragment set:html={I.download} /><span>PDF</span></button>
          <div class="menu-wrap">
            <button id="moreBtn" class="act" aria-haspopup="true" aria-expanded="false" title="Más opciones"><Fragment set:html={I.more} /><span>Más</span></button>
            <div id="moreMenu" class="menu" hidden>
              <button id="pngBtn">Descargar PNG</button>
              <button id="cuentaMenuBtn">Cuenta de cobro (PDF)</button>
              <hr />
              <button id="exportJsonBtn">Exportar JSON</button>
              <button id="importJsonBtn">Importar JSON…</button>
              <button id="exportMdBtn">Exportar Markdown</button>
            </div>
          </div>
          <input id="importJsonFile" type="file" accept=".json,application/json" hidden />
        </footer>
      </aside>

      <!-- ── Vista previa ───────────────────────────────────────────────── -->
      <main class="preview">
        <div class="preview-bar">
          <span id="previewEstado" class="badge"></span>
          <span id="previewTotal" class="preview-total"></span>
          <div class="zoom">
            <button id="zoomFit" class="chip active">Ajustar</button>
            <button id="zoom100" class="chip">100%</button>
          </div>
        </div>
        <div id="previewScroll" class="preview-scroll">
          <div id="previewStage" class="preview-stage">
            <iframe class="pv-frame front" title="Vista previa de la cotización" tabindex="-1"></iframe>
            <iframe class="pv-frame back" title="" aria-hidden="true" tabindex="-1"></iframe>
          </div>
        </div>
      </main>

      <!-- Alternar editor / vista previa en celular -->
      <nav class="mobile-switch" aria-label="Vista">
        <button data-view="edit" class="active"><Fragment set:html={I.edit} /> Editar</button>
        <button data-view="preview"><Fragment set:html={I.eye} /> Vista previa</button>
      </nav>
    </div>

    <div id="toast" class="toast" role="status" aria-live="polite"></div>

    <div id="welcomeModal" class="modal-overlay" hidden role="dialog" aria-modal="true" aria-labelledby="welcomeTitle">
      <div class="modal-box">
        <div class="modal-header">
          <img src="/logo.webp" alt="" width="40" height="40" />
          <div>
            <h2 id="welcomeTitle">Cotizador</h2>
            <p>Propuestas económicas con tu marca</p>
          </div>
        </div>
        <ol class="modal-steps">
          <li><b>Mi marca:</b> sube tu logo y tu firma una sola vez.</li>
          <li><b>Diseño:</b> elige una de 8 plantillas y tus dos colores.</li>
          <li><b>Cotización e ítems:</b> llena los datos y mira el resultado en vivo.</li>
          <li><b>PDF:</b> se descarga con el texto seleccionable, listo para enviar.</li>
        </ol>
        <p class="modal-note">Todo queda en tu navegador: sin registro y sin servidor.</p>
        <div class="modal-actions">
          <button id="welcomeStart" class="primary">Empezar con la guía</button>
          <button id="welcomeSkip">Empezar ya</button>
          <button id="welcomeNever" class="link-btn">No volver a mostrar</button>
        </div>
        <div class="modal-links">
          <a href="https://github.com/AndersonDavi/Cotizador" target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href="https://www.linkedin.com/in/anderson-david-rueda-consuegra/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </div>
      </div>
    </div>

    <noscript>
      <style>.app { display: none; }</style>
      <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;min-height:100vh;font-family:sans-serif;background:#0f1115;color:#e0e0e0;text-align:center;padding:32px">
        <strong style="font-size:1.4rem;margin-bottom:12px">Cotizador necesita JavaScript</strong>
        <p style="max-width:420px;color:#9a9a9a;line-height:1.6">Esta herramienta genera propuestas económicas directamente en tu navegador, sin servidor ni registro. Activa JavaScript para usarla.</p>
      </div>
    </noscript>

    <script>
      import { initEditor } from '../lib/editor';
      initEditor();
    </script>
  </body>
</html>
