              <button id="cuentaBtn" class="primary wide" type="button"><Fragment set:html={I.cash} /> Generar cuenta de cobro (PDF)</button>
              <label class="check" id="cobroMarcarWrap"><input id="cobroMarcar" type="checkbox" checked /> Marcar la cotización como <b>cobrada</b></label>
              <button id="cuentaRepetir" type="button" class="pill-btn" hidden><Fragment set:html={I.repeat} /> Repetir el próximo mes</button>
