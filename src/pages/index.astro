---
import '../styles/global.css';
import 'driver.js/dist/driver.css';
import '@fontsource/roboto/400.css';
import '@fontsource/roboto/500.css';
import '@fontsource/roboto/700.css';
import { NOVEDADES } from '../lib/novedades';

const B = __BUILD__;

const SITE = 'https://cotizador.andersonrueda.com';
const TITLE = 'Cotizador: crea cotizaciones y cuentas de cobro en PDF gratis';
const DESC  = 'Genera cotizaciones y cuentas de cobro en PDF con tu logo y firma. IVA, anticipos, 11 plantillas y WhatsApp. Gratis, ilimitado, sin anuncios ni registro.';

const ic = (d: string) => `<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const I = {
  doc: ic('<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="8" y1="13" x2="16" y2="13"/><line x1="8" y1="17" x2="13" y2="17"/>'),
  list: ic('<line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><circle cx="4" cy="6" r="1"/><circle cx="4" cy="12" r="1"/><circle cx="4" cy="18" r="1"/>'),
  palette: ic('<circle cx="13.5" cy="6.5" r="1.5"/><circle cx="17.5" cy="10.5" r="1.5"/><circle cx="8.5" cy="7.5" r="1.5"/><circle cx="6.5" cy="12.5" r="1.5"/><path d="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.9 0 1.6-.7 1.6-1.7 0-.4-.2-.8-.4-1.1-.3-.3-.4-.7-.4-1.1a1.6 1.6 0 0 1 1.7-1.7h2c3 0 5.5-2.5 5.5-5.5C22 6 17.5 2 12 2z"/>'),
  brand: ic('<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/>'),
  cash: ic('<rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="12" cy="12" r="2.5"/><path d="M6 12h.01M18 12h.01"/>'),
  folder: ic('<path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>'),
  upload: ic('<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>'),
  pen: ic('<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/>'),
  save: ic('<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>'),
  plus: ic('<line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>'),
  download: ic('<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>'),
  more: ic('<circle cx="12" cy="12" r="1"/><circle cx="19" cy="12" r="1"/><circle cx="5" cy="12" r="1"/>'),
  help: ic('<circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/>'),
  eye: ic('<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/>'),
  edit: ic('<path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4z"/>'),
  install: ic('<rect x="5" y="2" width="14" height="20" rx="2"/><path d="M12 7v7"/><path d="m9 11 3 3 3-3"/><path d="M10 18h4"/>'),
  repeat: ic('<path d="m17 2 4 4-4 4"/><path d="M3 11v-1a4 4 0 0 1 4-4h14"/><path d="m7 22-4-4 4-4"/><path d="M21 13v1a4 4 0 0 1-4 4H3"/>'),
  cal: ic('<rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>'),
};
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content" />

    <title>{TITLE}</title>
    <meta name="description" content={DESC} />
    <meta name="keywords" content="cuenta de cobro, generar cuenta de cobro, cuenta de cobro PDF, formato cuenta de cobro Colombia, cotización PDF, generador de cotizaciones, cotizador gratis, cotizaciones gratis sin anuncios, cuentas de cobro ilimitadas, sin registro, sin marca de agua, cotización con IVA, propuesta económica, presupuesto online, freelance" />
    <meta name="author" content="Anderson Rueda" />
    <meta name="robots" content="index, follow" />
    <meta name="google-site-verification" content="ahZS4qCnXiX1NPEs2xwk0r2orlPFeorWpFTa6KkBEok" />
    <link rel="canonical" href={SITE} />

    <meta property="og:type"         content="website" />
    <meta property="og:url"          content={SITE} />
    <meta property="og:site_name"    content="Cotizador" />
    <meta property="og:title"        content={TITLE} />
    <meta property="og:description"  content={DESC} />
    <meta property="og:locale"       content="es_CO" />
    <meta property="og:image"        content={`${SITE}/og-image.jpg`} />
    <meta property="og:image:secure_url" content={`${SITE}/og-image.jpg`} />
    <meta property="og:image:type"   content="image/jpeg" />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt"    content="Cotizador: cotizaciones y cuentas de cobro en PDF con tu logo, en 11 plantillas" />

    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={TITLE} />
    <meta name="twitter:description" content={DESC} />
    <meta name="twitter:image"       content={`${SITE}/og-image.jpg`} />
    <meta name="twitter:image:alt"   content="Cotizador: cotizaciones y cuentas de cobro en PDF" />

    <link rel="manifest" href="/manifest.json" />
    <!-- El navegador avisa que se puede instalar muy temprano: se guarda aquí para que editor.ts no se lo pierda -->
    <script is:inline>window.addEventListener("beforeinstallprompt", function (e) { e.preventDefault(); window.__instalar = e; });</script>
    <meta name="theme-color" content="#15181e" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Cotizador" />

    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "Cotizador",
      "alternateName": "Generador de cotizaciones y cuentas de cobro",
      "url": SITE,
      "description": DESC,
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Web",
      "browserRequirements": "Requires JavaScript. Compatible con Chrome, Firefox, Safari y Edge.",
      "inLanguage": "es-CO",
      "isAccessibleForFree": true,
      "keywords": "cotizaciones, cuentas de cobro, gratis, ilimitado, sin anuncios, sin registro, sin marca de agua",
      "featureList": [
        "Cotizaciones en PDF con logo, firma y colores",
        "Cuentas de cobro con valor en letras",
        "IVA sumado o incluido, por ítem",
        "Descuentos, anticipos y vigencia",
        "11 plantillas de diseño",
        "Envío por WhatsApp",
        "Respaldo en Google Drive",
        "Funciona sin conexión",
        "Gratis, ilimitado y sin anuncios"
      ],
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "COP" },
      "image": `${SITE}/og-image.jpg`,
      "screenshot": `${SITE}/og-image.jpg`,
      "author": {
        "@type": "Person",
        "name": "Anderson Rueda",
        "url": "https://andersonrueda.com",
        "sameAs": ["https://github.com/AndersonDavi", "https://www.linkedin.com/in/anderson-david-rueda-consuegra/"]
      }
    })} />
  </head>
  <body>
    <div class="app" data-view="edit">
      <!-- ── Editor ─────────────────────────────────────────────────────── -->
      <aside class="editor">
        <header class="topbar">
          <div class="brandmark">
            <img src="/logo.svg" alt="" width="32" height="32" />
            <div>
              <h1>Cotizador</h1>
              <span id="docLabel" class="doc-label">Cotización 00001</span>
            </div>
          </div>
          <div class="top-actions">
            <button id="installChip" class="ghost-btn top-chip install-chip" type="button" hidden title="Instalar el Cotizador como app (funciona sin conexión)"><Fragment set:html={I.install} /><span>Instalar</span></button>
            <button id="driveChip" class="ghost-btn top-chip drive-chip" type="button" hidden data-state="off" title="Respaldo en Google Drive"><span class="drive-ic" aria-hidden="true"></span><span class="drive-label">Respaldar</span></button>
            <button id="helpBtn" class="ghost-btn top-chip" title="Video, guías y preguntas frecuentes"><Fragment set:html={I.help} /><span>Ayuda</span></button>
          </div>
        </header>

        <nav class="tabs" role="tablist" aria-label="Secciones">
          <button role="tab" class="tab active" data-tab="cotizacion" id="tab-cotizacion"><Fragment set:html={I.doc} /><span>Cotización</span></button>
          <button role="tab" class="tab" data-tab="items" id="tab-items"><Fragment set:html={I.list} /><span>Ítems</span><b id="itemsCount" class="count">0</b></button>
          <button role="tab" class="tab" data-tab="diseno" id="tab-diseno"><Fragment set:html={I.palette} /><span>Diseño</span></button>
          <button role="tab" class="tab" data-tab="marca" id="tab-marca"><Fragment set:html={I.brand} /><span>Mi marca</span></button>
          <button role="tab" class="tab" data-tab="cobro" id="tab-cobro"><Fragment set:html={I.cash} /><span>Cobro</span></button>
          <button role="tab" class="tab" data-tab="guardadas" id="tab-guardadas"><Fragment set:html={I.folder} /><span>Guardadas</span></button>
        </nav>

        <div class="panes">
          <!-- Cotización -->
          <section class="pane active" data-pane="cotizacion">
            <button class="pane-help" type="button" data-tour="cotizacion"><Fragment set:html={I.help} /> Guía de esta sección</button>
            <div class="card hero-card">
              <div class="hero-top">
                <div class="hero-num">
                  <span class="eyebrow">Cotización</span>
                  <label class="num-field"><span aria-hidden="true">N.º</span><input id="numero" type="text" inputmode="numeric" aria-label="Número de cotización" /></label>
                </div>
                <label class="field hero-date">Fecha<input id="fecha" type="text" data-date placeholder="dd-mm-aaaa" /></label>
              </div>
              <label class="field">Oferta válida por
                <span class="with-suffix"><input id="vigencia" type="text" inputmode="numeric" placeholder="15" /><i>días</i></span>
                <small id="validaHint" class="hint"></small>
              </label>
              <div class="field">Estado
                <div id="estadoGroup" class="seg" role="radiogroup" aria-label="Estado"></div>
              </div>
              <details class="more">
                <summary>Título del documento</summary>
                <label class="field"><span class="sr-only">Título del documento</span><input id="titulo" type="text" placeholder="Propuesta económica" /></label>
                <p class="hint">Aparece en el encabezado. Por ejemplo: Cotización, Presupuesto, Propuesta comercial.</p>
              </details>
            </div>

            <div class="card">
              <h3 class="card-title">¿Para quién es?</h3>
              <div class="grid2">
                <label class="field">Cliente<input id="clienteNombre" type="text" list="clientesList" placeholder="Panadería La Esquina S.A.S." autocomplete="organization" /></label>
                <label class="field">NIT o documento<input id="clienteNit" type="text" placeholder="901.234.567-8" /></label>
              </div>
              <label class="field">Celular del cliente <small>para enviarle la cotización por WhatsApp</small><input id="clienteCel" type="tel" placeholder="300 000 0000" /></label>
              <datalist id="clientesList"></datalist>
              <label class="field">Alcance <small>una frase que resuma el trabajo</small><textarea id="alcance" class="auto" rows="1" placeholder="Sitio web y tienda en línea para la panadería"></textarea></label>
            </div>

            <div class="card total-card">
              <div class="total-row">
                <div>
                  <span class="eyebrow">Total de la propuesta</span>
                  <div class="total-big" id="totalBig">$0</div>
                  <span class="hint" id="totalHint"></span>
                </div>
                <label class="switch"><input id="costoAuto" type="checkbox" /><span></span> Sumar ítems</label>
              </div>
              <label class="field" id="costoManualWrap">Valor total (COP)<input id="costoTotal" type="text" data-money /></label>
              <div class="field">IVA
                <div id="ivaSeg" class="seg" role="radiogroup" aria-label="IVA">
                  <button type="button" data-iva="ninguno" style="--dot:#8b93a1">Sin IVA</button>
                  <button type="button" data-iva="agregar" style="--dot:#5aa9ff">Sumar IVA</button>
                  <button type="button" data-iva="incluido" style="--dot:#4ec47e">IVA incluido</button>
                </div>
              </div>
              <div class="tax-grid">
                <label class="field" id="ivaTasaWrap">Tasa de IVA<span class="with-suffix"><input id="ivaTasa" type="text" inputmode="decimal" placeholder="19" /><i>%</i></span></label>
                <label class="field">Descuento<span class="with-btn"><input id="descuento" type="text" inputmode="decimal" placeholder="0" /><button id="descTipo" type="button" class="icon-only" title="Cambiar entre porcentaje y valor">%</button></span></label>
                <label class="field">Anticipo<span class="with-suffix"><input id="anticipo" type="text" inputmode="numeric" placeholder="0" /><i>%</i></span></label>
              </div>
              <dl id="desglose" class="desglose-ui" hidden></dl>
            </div>

            <div class="card">
              <h3 class="card-title">Condiciones</h3>
              <label class="field">Tiempo de entrega<textarea id="tiempoEntrega" class="auto" rows="2" placeholder="15 días hábiles a partir de la aprobación."></textarea></label>
              <div class="field">Términos y condiciones
                <div id="terminosList" class="terms-list"></div>
                <button id="addTermino" type="button" class="link-btn add-term"><Fragment set:html={I.plus} /> Agregar término</button>
              </div>
            </div>
          </section>

          <!-- Ítems -->
          <section class="pane" data-pane="items">
            <button class="pane-help" type="button" data-tour="items"><Fragment set:html={I.help} /> Guía de esta sección</button>
            <div class="items-toolbar">
              <span class="toolbar-label">Ordenar</span>
              <button id="sort-precio" class="chip">Precio</button>
              <button id="sort-titulo" class="chip">Título</button>
              <button id="sort-tipo" class="chip">Tipo</button>
              <button id="toggleAllItems" class="chip chip-outline">Colapsar todo</button>
            </div>
            <div id="items" class="items"></div>
            <div class="items-foot">
              <div class="items-sum"><span id="itemsSummary">0 ítems</span><b id="itemsTotal">$0</b></div>
              <div class="items-foot-acts">
                <button id="fromCatalog" class="add-cat" type="button" title="Agregar un servicio guardado"><Fragment set:html={I.folder} /> Catálogo</button>
                <button id="addItem" class="primary add-item"><Fragment set:html={I.plus} /> Agregar ítem</button>
              </div>
            </div>
            <datalist id="unidades">
              <option value="und"></option><option value="m"></option><option value="m²"></option><option value="m³"></option>
              <option value="horas"></option><option value="días"></option><option value="meses"></option><option value="punto"></option>
              <option value="visita"></option><option value="servicio"></option><option value="global"></option><option value="kg"></option><option value="licencia"></option>
            </datalist>
          </section>

          <!-- Diseño -->
          <section class="pane" data-pane="diseno">
            <button class="pane-help" type="button" data-tour="diseno"><Fragment set:html={I.help} /> Guía de esta sección</button>
            <div class="card">
              <h3 class="card-title">Plantilla</h3>
              <div id="designGallery" class="gallery"></div>
              <label class="switch opt-row"><input id="iconosItems" type="checkbox" /><span></span> Íconos en la lista de ítems</label>
              <small class="hint">En Bloque, Noche, Diagonal, Estudio, Panel, Corporativa y Mosaico el ícono reemplaza el número, que pasa al título ("1. Diseño de logo").</small>
              <label class="switch opt-row"><input id="aceptacionCliente" type="checkbox" /><span></span> Espacio para la firma de aceptación del cliente</label>
              <small class="hint">Agrega debajo de tu firma una línea para que el cliente firme al aprobar la cotización. Sale en todas las plantillas.</small>
            </div>
            <div class="card">
              <h3 class="card-title">Colores <small>toda la plantilla sale de estos dos</small></h3>
              <div class="grid2">
                <button type="button" class="color-field" id="colorPrimaryBtn" data-which="primary" aria-haspopup="dialog">
                  <i class="sw" id="colorPrimarySw"></i>
                  <span><b>Principal</b><code id="colorPrimaryHex"></code></span>
                </button>
                <button type="button" class="color-field" id="colorSecondaryBtn" data-which="secondary" aria-haspopup="dialog">
                  <i class="sw" id="colorSecondarySw"></i>
                  <span><b>Secundario</b><code id="colorSecondaryHex"></code></span>
                </button>
              </div>
              <div id="contrastBox" class="contrast" role="status" aria-live="polite"></div>
              <div class="field">Paletas rápidas<div id="paletteRow" class="palettes"></div></div>
              <div class="field"><span class="field-row">Mis paletas <button id="savePalette" class="pill-btn" type="button">＋ Guardar mis colores</button></span><div id="myPalettes" class="palettes"></div></div>
              <div class="link-row">
                <button id="swapColors" class="link-btn" type="button">⇄ Intercambiar colores</button>
                <button id="suggestColors" class="link-btn" type="button">Usar colores sugeridos del diseño</button>
              </div>
            </div>
          </section>

          <!-- Mi marca -->
          <section class="pane" data-pane="marca">
            <button class="pane-help" type="button" data-tour="marca"><Fragment set:html={I.help} /> Guía de esta sección</button>
            <div class="card" id="perfilCard">
              <h3 class="card-title">Perfil de marca <small>cada cotización usa uno</small></h3>
              <div id="perfilChips" class="seg perfiles" role="radiogroup" aria-label="Perfil de marca"></div>
              <div class="perfil-acciones">
                <button id="perfilNuevo" class="pill-btn" type="button">＋ Nuevo perfil</button>
                <button id="perfilRenombrar" class="link-btn" type="button">Renombrar</button>
                <button id="perfilEliminar" class="link-btn danger" type="button">Eliminar</button>
              </div>
              <p id="perfilHint" class="hint"></p>
              <div id="marcaAviso" class="marca-aviso" hidden>
                <p><b>Esta cotización tiene su propia marca.</b> Conserva los datos de cuando la guardaste, distintos a tu perfil. Lo que cambies aquí solo la afecta a ella.</p>
                <button id="marcaUsarPerfil" class="pill-btn" type="button">Usar mi perfil actual</button>
              </div>
            </div>
            <div class="card">
              <h3 class="card-title">Logo y nombre</h3>
              <div class="brand-row">
                <div id="logoArea" class="drop" tabindex="0" role="button" title="Sube o arrastra tu logo">
                  <img id="logoPreview" alt="Logo" />
                  <span class="drop-empty"><Fragment set:html={I.upload} />Logo</span>
                </div>
                <div class="brand-fields">
                  <label class="field">Nombre de tu marca<input id="empresa" type="text" placeholder="Mi Estudio" /></label>
                  <button id="logoClear" class="link-btn danger" type="button">Quitar logo</button>
                </div>
              </div>
              <div class="field" id="logoEstiloWrap">Cómo se ve tu logo
                <div id="logoEstilo" class="seg" role="radiogroup" aria-label="Cómo se ve tu logo">
                  <button type="button" data-logo="original" role="radio">Original</button>
                  <button type="button" data-logo="fondo" role="radio">Fondo blanco</button>
                  <button type="button" data-logo="blanco" role="radio">Todo blanco</button>
                  <button type="button" data-logo="negro" role="radio">Todo negro</button>
                  <button type="button" data-logo="primario" role="radio">Color principal</button>
                  <button type="button" data-logo="secundario" role="radio">Color secundario</button>
                </div>
                <small class="hint">Fondo blanco ayuda a un logo a color sobre un diseño oscuro. Todo blanco, todo negro o tus colores sirven para logos de un solo color con fondo transparente.</small>
              </div>
              <input id="logoFile" type="file" accept="image/*" hidden />
              <svg width="0" height="0" style="position:absolute" aria-hidden="true"><filter id="logo-tinte-ui" color-interpolation-filters="sRGB"><feFlood id="logoTinteUi" flood-color="#ffffff"/><feComposite in2="SourceAlpha" operator="in"/></filter></svg>
            </div>

            <div class="card">
              <h3 class="card-title">Quién firma</h3>
              <div class="grid2">
                <label class="field">Nombre<input id="repNombre" type="text" /></label>
                <label class="field">Cédula / NIT<input id="repCedula" type="text" /></label>
              </div>
              <div class="field">Firma
                <div id="firmaArea" class="drop drop-wide" tabindex="0" role="button" title="Sube o arrastra una imagen de tu firma">
                  <img id="firmaPreview" alt="Firma" />
                  <span class="drop-empty"><Fragment set:html={I.pen} />Sube una foto o PNG de tu firma (el fondo blanco se recorta solo)</span>
                </div>
                <button id="firmaClear" class="link-btn danger" type="button">Quitar firma</button>
                <input id="firmaFile" type="file" accept="image/*" hidden />
              </div>
            </div>

            <div class="card">
              <h3 class="card-title">Contacto</h3>
              <div class="grid2">
                <label class="field">Celular<input id="cCel" type="tel" /></label>
                <label class="field">Email<input id="cEmail" type="email" /></label>
              </div>
              <label class="field">Sitio web<input id="cWeb" type="text" placeholder="www.mimarca.com" /></label>
              <div class="grid2">
                <label class="field">Ciudad<input id="cCiudad" type="text" /></label>
